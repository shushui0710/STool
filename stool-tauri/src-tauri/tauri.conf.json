{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "STool",
  "version": "0.1.0",
  "identifier": "com.stool.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "STool",
        "width": 1180,
        "height": 820,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
